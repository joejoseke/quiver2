{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brane-shop-backend",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./uploads",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db",
      "database_id": "89bcb680-ebb3-4be5-adf6-51c2bf6325f9"
    }
  ],
  "vars": {
    "APP_BASE_URL": "http://localhost:8787",
    "FRONTEND_BASE_URL": "http://localhost:5173",
    "MPESA_MODE": "n8n",
    "N8N_STK_WEBHOOK": "https://connector.kaylan.digital/webhook/5f7141a7-399d-4722-b838-a3a615dt67UIo"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
